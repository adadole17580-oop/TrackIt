<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500" prefWidth="700" style="-fx-background-color: #d9d9d9;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.trackitapp.ProfileController">

    <children>

        <AnchorPane prefHeight="513.0" prefWidth="759.0">
            <children>

                <AnchorPane layoutY="49.0" prefHeight="466.0" prefWidth="200.0" style="-fx-background-color: white;">
                    <children>

                        <VBox layoutX="6.0" layoutY="12.0" prefHeight="454.0" prefWidth="187.0">

                            <children>

                                <Button fx:id="btnDashboard"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text=" Dashboard"
                                        onAction="#goDashboard">
                                    <padding>
                                        <Insets bottom="5.0" right="45.0" top="5.0"/>
                                    </padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/1.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnAddExpenses"
                                        layoutY="10.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text=" Add Expenses"
                                        onAction="#goAddExpenses">
                                    <padding><Insets bottom="5.0" right="26.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/2.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnViewExpenses"
                                        layoutY="47.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text="View Expenses"
                                        onAction="#goViewExpenses">
                                    <padding><Insets bottom="5.0" right="20.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/3.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnSetBudgets"
                                        layoutY="84.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text="Set Budgets"
                                        onAction="#goSetBudgets">
                                    <padding><Insets bottom="5.0" right="35.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/4.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnReports"
                                        layoutY="158.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text="Reports"
                                        onAction="#goReports">
                                    <padding><Insets bottom="5.0" right="61.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/5.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnNotifications"
                                        layoutY="158.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: transparent;"
                                        text="Notifications"
                                        onAction="#goNotifications">
                                    <padding><Insets bottom="5.0" right="30.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/6.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                                <Button fx:id="btnProfile"
                                        layoutY="195.0"
                                        prefHeight="37.0" prefWidth="200.0"
                                        style="-fx-background-color: CBDCEB;"
                                        text="Profile"
                                        onAction="#goProfile">
                                    <padding><Insets bottom="5.0" right="68.0" top="5.0"/></padding>
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="17.0">
                                            <image><Image url="@icons/7.png"/></image>
                                        </ImageView>
                                    </graphic>
                                    <font><Font size="14.0"/></font>
                                </Button>

                            </children>

                        </VBox>

                    </children>
                </AnchorPane>

                <AnchorPane layoutX="198.0" layoutY="49.0" prefHeight="466.0" prefWidth="563.0">

                    <children>

                        <AnchorPane layoutX="15.0" layoutY="45.0" prefHeight="160.0" prefWidth="530.0"
                                    style="-fx-background-color: white; -fx-border-radius: 6;">
                            <children>

                                <Label layoutX="8.0" text="Profile Information">
                                    <font><Font name="Georgia Bold" size="15.0"/></font>
                                </Label>

                                <ImageView fitHeight="61.0" fitWidth="61.0" layoutX="81.0" layoutY="42.0">
                                    <image><Image url="@icons/7.png"/></image>
                                </ImageView>

                                <Label layoutX="203.0" layoutY="56.0" fx:id="lblName" text="User Name"/>
                                <Label layoutX="203.0" layoutY="103.0" fx:id="lblEmail" text="email@example.com"/>
                                <Label layoutX="203.0" layoutY="125.0" fx:id="lblMemberDate" text="Member since mm/dd/yyyy"/>

                                <Button fx:id="btnEditProfile"
                                        layoutX="45.0" layoutY="120.0"
                                        prefHeight="26.0" prefWidth="134.0"
                                        style="-fx-background-color: CBDCEB;"
                                        text="Edit Profile"
                                        onAction="#editProfile"/>

                            </children>

                            <effect>
                                <DropShadow height="44.45" offsetX="2" offsetY="2" radius="19.5">
                                    <color><Color opacity="0.31"/></color>
                                </DropShadow>
                            </effect>

                        </AnchorPane>

                        <AnchorPane layoutX="15.0" layoutY="244.0" prefHeight="131.0" prefWidth="530.0"
                                    style="-fx-background-color: white; -fx-border-radius: 5;">

                            <children>

                                <Label layoutX="8.0" text="Account Action">
                                    <font><Font name="Georgia Bold" size="15.0"/></font>
                                </Label>

                                <Label layoutX="15.0" layoutY="37.0"
                                       text="Please be certain with your changes."/>

                                <Button fx:id="btnChangePassword"
                                        layoutX="14.0" layoutY="80.0"
                                        prefHeight="26.0" prefWidth="134.0"
                                        style="-fx-background-color: CBDCEB;"
                                        text="Change Password"
                                        onAction="#changePassword"/>

                                <Button fx:id="btnLogout"
                                        layoutX="191.0" layoutY="80.0"
                                        prefHeight="26.0" prefWidth="134.0"
                                        style="-fx-background-color: D24444;"
                                        text="LogOut Account"
                                        textFill="WHITE"
                                        onAction="#logoutAccount"/>

                                <Button fx:id="btnDeleteAccount"
                                        layoutX="363.0" layoutY="80.0"
                                        prefHeight="26.0" prefWidth="134.0"
                                        style="-fx-background-color: FA0202;"
                                        text="Delete Account"
                                        textFill="WHITE"
                                        onAction="#deleteAccount"/>

                            </children>

                            <effect>
                                <DropShadow height="44.45" offsetX="2" offsetY="2" radius="19.5">
                                    <color><Color opacity="0.31"/></color>
                                </DropShadow>
                            </effect>

                        </AnchorPane>

                    </children>

                </AnchorPane>

            </children>
        </AnchorPane>

        <AnchorPane prefHeight="49.0" prefWidth="761.0"
                    style="-fx-background-color: EBEBEB; -fx-border-color: CBDCEB;">
            <children>

                <Label layoutX="53.0" layoutY="8.0" text="Expense Tracker">
                    <font><Font name="Georgia Bold" size="19.0"/></font>
                </Label>

                <ImageView layoutX="10.0" layoutY="7.0" fitHeight="35" fitWidth="46">
                    <image><Image url="@icons/14.png"/></image>
                </ImageView>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
