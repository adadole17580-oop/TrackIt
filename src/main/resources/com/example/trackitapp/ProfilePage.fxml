<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="700"
            prefHeight="500"
            style="-fx-background-color: #d9d9d9;">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20" layoutY="20" prefWidth="700">
            <children>
                <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="650" prefHeight="150" style="-fx-background-color: #edf2f1; -fx-background-radius: 20;">
                    <padding>
                        <Insets left="30" right="30" top="20" bottom="20"/>
                    </padding>
                    <children>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <children>
                                <StackPane prefWidth="60" prefHeight="60" style="-fx-background-color: #8ca7b3; -fx-background-radius: 30;">
                                    <Label text="AD" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                </StackPane>
                                <VBox spacing="5">
                                    <Label text="Angel Dadole" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                    <Hyperlink text="AngelDadole@gmail.com" style="-fx-text-fill: black; -fx-font-size: 12px;"/>
                                    <Label text="Member since 09/22/2025" style="-fx-font-size: 12px;"/>
                                </VBox>
                            </children>
                        </HBox>
                        <Button text="Edit Profile" style="-fx-background-color: #a3b7b2; -fx-font-size: 12px;" />
                    </children>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="650" prefHeight="80" style="-fx-background-color: #edf2f1; -fx-background-radius: 20;">
                    <padding>
                        <Insets left="30" right="30" top="15" bottom="15"/>
                    </padding>
                    <children>
                        <Label text="Change Password" style="-fx-font-weight: bold;"/>
                        <Button text="Change Password" style="-fx-background-color: #d3d3d3; -fx-font-size: 12px;"/>
                    </children>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT" prefWidth="650" prefHeight="150" style="-fx-background-color: #edf2f1; -fx-background-radius: 20;">
                    <padding>
                        <Insets left="30" right="30" top="15" bottom="15"/>
                    </padding>
                    <children>
                        <Label text="Account Action" style="-fx-font-weight: bold;"/>
                        <Button text="Log Out" style="-fx-background-color: #f2f2f2; -fx-border-color: red; -fx-text-fill: red; -fx-font-size: 12px;"/>
                        <Separator prefWidth="550"/>
                        <Label text="Warning!" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
                        <Label text="Once you delete your account, there is no going back. Please be certain." style="-fx-font-size: 12px;"/>
                        <Button text="Delete Account" style="-fx-background-color: #f2f2f2; -fx-border-color: red; -fx-text-fill: red; -fx-font-size: 12px;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
