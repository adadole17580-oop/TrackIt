<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="513.0" prefWidth="759.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.trackitapp.AddExpensesController">

    <children>

        <AnchorPane prefHeight="49.0" prefWidth="759.0"
                    style="-fx-background-color: EBEBEB; -fx-border-color: CBDCEB;">
            <children>
                <Label layoutX="53.0" layoutY="8.0"
                       prefHeight="33.0" prefWidth="171.0"
                       text="Expense Tracker">
                    <font><Font name="Georgia Bold" size="19.0"/></font>
                </Label>

                <ImageView fitHeight="35.0" fitWidth="46.0"
                           layoutX="10.0" layoutY="7.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@icons/14.png"/>
                    </image>
                </ImageView>
            </children>
        </AnchorPane>

        <AnchorPane layoutY="49.0" prefHeight="466.0" prefWidth="200.0"
                    style="-fx-background-color: white;">
            <children>
                <VBox layoutX="6.0" layoutY="12.0"
                      prefHeight="454.0" prefWidth="187.0"
                      style="-fx-background-color: white;">

                    <children>
                        <Button fx:id="dashboardBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: CBDCEB;" text=" Dashboard">
                            <padding><Insets bottom="5.0" right="45.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0" preserveRatio="true">
                                    <image><Image url="@icons/1.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="addExpensesBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text=" Add Expenses">
                            <padding><Insets bottom="5.0" right="26.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0" preserveRatio="true">
                                    <image><Image url="@icons/2.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="viewExpensesBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text="View Expenses">
                            <padding><Insets bottom="5.0" right="20.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0" preserveRatio="true">
                                    <image><Image url="@icons/3.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="setBudgetsBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text="Set Budgets">
                            <padding><Insets bottom="5.0" right="35.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0">
                                    <image><Image url="@icons/4.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="reportsBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text="Reports">
                            <padding><Insets bottom="5.0" right="61.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0">
                                    <image><Image url="@icons/5.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="notificationsBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text="Notifications">
                            <padding><Insets bottom="5.0" right="30.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0">
                                    <image><Image url="@icons/6.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                        <Button fx:id="profileBtn" prefHeight="37.0" prefWidth="200.0"
                                style="-fx-background-color: transparent;" text="Profile">
                            <padding><Insets bottom="5.0" right="68.0" top="5.0"/></padding>
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="17.0">
                                    <image><Image url="@icons/7.png"/></image>
                                </ImageView>
                            </graphic>
                            <font><Font size="14.0"/></font>
                        </Button>

                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="200.0" layoutY="49.0"
                    prefHeight="466.0" prefWidth="559.0">

            <children>

                <AnchorPane layoutX="63.0" layoutY="40.0"
                            prefHeight="365.0" prefWidth="435.0"
                            style="-fx-background-color: white;">

                    <children>

                        <Label layoutX="14.0" layoutY="14.0" text="Add New Expenses">
                            <font><Font name="Georgia Bold" size="15.0"/></font>
                        </Label>

                        <Label layoutX="24.0" layoutY="51.0" text="Amount"/>
                        <ImageView fitHeight="20.0" fitWidth="17.0"
                                   layoutX="24.0" layoutY="76.0"
                                   preserveRatio="true">
                            <image><Image url="@icons/13.png"/></image>
                        </ImageView>

                        <TextField fx:id="amountField"
                                   layoutX="49.0" layoutY="72.0"/>

                        <Label layoutX="24.0" layoutY="108.0" text="Category"/>
                        <ChoiceBox fx:id="categoryChoice"
                                   layoutX="24.0" layoutY="130.0"
                                   prefHeight="25.0" prefWidth="388.0"/>

                        <Label layoutX="24.0" layoutY="170.0" text="Date"/>
                        <DatePicker fx:id="datePicker"
                                    layoutX="24.0" layoutY="190.0"
                                    prefHeight="25.0" prefWidth="183.0"/>

                        <Label layoutX="24.0" layoutY="230.0" text="Notes (Optional)"/>
                        <TextField fx:id="notesField"
                                   layoutX="24.0" layoutY="255.0"
                                   prefHeight="37.0" prefWidth="388.0"/>

                        <Button fx:id="cancelBtn" layoutX="66.0" layoutY="309.0"
                                prefHeight="33.0" prefWidth="115.0"
                                style="-fx-background-color: CBDCEB;" text="Cancel"/>

                        <Button fx:id="saveBtn" layoutX="246.0" layoutY="309.0"
                                prefHeight="33.0" prefWidth="115.0"
                                style="-fx-background-color: CBDCEB;" text="Save Expenses"/>

                        <Label fx:id="messageLabel"
                               layoutX="24.0" layoutY="350.0" text=""/>

                    </children>

                    <effect>
                        <DropShadow height="100.14" width="100.14"
                                    radius="49.57" offsetX="3.0" offsetY="3.0">
                            <color><Color opacity="0.35"/></color>
                        </DropShadow>
                    </effect>

                </AnchorPane>

            </children>
        </AnchorPane>

    </children>

</AnchorPane>
